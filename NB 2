# ============================================================
# 1. ADDUCT MASS CHEMISTRY
# ============================================================

 
ELEMENT_MASS = {
    "H": 1.0078250319, "C": 12.0, "N": 14.0030740052, "O": 15.9949146221,
    "Na": 22.98976928, "K": 38.96370649, "Cl": 34.96885268,
    "S": 31.97207069, "Br": 78.9183371, "I": 126.904473,
}
ELECTRON_MASS = 0.00054858
 
FORMULA_ALIASES = {
    "FA": "CH2O2", "Hac": "C2H4O2", "AcOH": "C2H4O2",
    "ACN": "C2H3N", "DMSO": "C2H6OS", "IsoProp": "C3H8O", "TFA": "C2HF3O2",
}
 
_formula_token_re = re.compile(r"([A-Z][a-z]?)(\d*)")
_warned_adducts = set()
 
 
def formula_mass(formula: str) -> float:
    formula = FORMULA_ALIASES.get(formula, formula)
    mass = 0.0
    for el, cnt in _formula_token_re.findall(formula):
        if not el:
            continue
        n = int(cnt) if cnt else 1
        mass += ELEMENT_MASS.get(el, 0.0) * n
    return mass
 
 
def _default_adduct(adduct_str):
    if adduct_str not in _warned_adducts:
        _warned_adducts.add(adduct_str)
        print(f"  [adduct] could not parse '{adduct_str}', assuming [M+H]+")
    return 1, ELEMENT_MASS["H"], 1, 1  # mult, shift, charge, sign
 
 
def parse_adduct(adduct_str):
    """Returns (mult, shift, charge, sign) such that
    precursor_mz = (mult*M + shift - sign*charge*e) / charge
    """
    if not isinstance(adduct_str, str):
        return _default_adduct(adduct_str)
    s = adduct_str.strip()
    m = re.match(r"^\[(\d*)M((?:[+-][^\[\]]+)*)\](\d*)([+-])$", s)
    if not m:
        return _default_adduct(adduct_str)
    mult_str, mods_str, charge_str, sign_str = m.groups()
    mult = int(mult_str) if mult_str else 1
    charge = int(charge_str) if charge_str else 1
    sign = 1 if sign_str == "+" else -1
    shift = 0.0
    for tok in re.findall(r"[+-][^+-]+", mods_str):
        tsign = 1 if tok[0] == "+" else -1
        rest = tok[1:]
        mm = re.match(r"^(\d*)(.*)$", rest)
        count = int(mm.group(1)) if mm.group(1) else 1
        group = mm.group(2)
        gm = formula_mass(group)
        if gm == 0.0 and group not in FORMULA_ALIASES:
            # unparseable modifier group -> bail out to a safe default
            return _default_adduct(adduct_str)
        shift += tsign * count * gm
    return mult, shift, charge, sign
 
 
def compute_neutral_masses(df: pd.DataFrame) -> np.ndarray:
    uniq = df["adduct"].unique()
    params = {a: parse_adduct(a) for a in uniq}
    mult = df["adduct"].map(lambda a: params[a][0]).to_numpy(dtype=float)
    shift = df["adduct"].map(lambda a: params[a][1]).to_numpy(dtype=float)
    charge = df["adduct"].map(lambda a: params[a][2]).to_numpy(dtype=float)
    sign = df["adduct"].map(lambda a: params[a][3]).to_numpy(dtype=float)
    pmz = df["precursor_mz"].to_numpy(dtype=float)
    return (pmz * charge - shift + sign * charge * ELECTRON_MASS) / mult
 
 
def neutral_mass_of_query(precursor_mz, adduct):
    mult, shift, charge, sign = parse_adduct(adduct)
    return (precursor_mz * charge - shift + sign * charge * ELECTRON_MASS) / mult
 
 
# ============================================================
# 2. SPECTRUM PREPROCESSING.
# ============================================================
 
 
def preprocess_spectrum(mz, inten, max_peaks=MAX_PEAKS, min_rel_intensity=MIN_REL_INTENSITY):
    mz = np.asarray(mz, dtype=float)
    inten = np.asarray(inten, dtype=float)
    if inten.size == 0:
        return mz, inten
    m = inten.max()
    if m <= 0:
        return mz, inten
    inten = inten / m
    mask = inten >= min_rel_intensity
    mz, inten = mz[mask], inten[mask]
    if mz.size > max_peaks:
        keep = np.argsort(-inten)[:max_peaks]
        keep = np.sort(keep)
        mz, inten = mz[keep], inten[keep]
    order = np.argsort(mz)
    return mz[order], inten[order]
 
 
# ============================================================
# 3. SPECTRAL.
# ============================================================
 
 
def weighted_cosine(q_mz, q_i, c_mz, c_i, tol_da,
                     intensity_power=INTENSITY_POWER, mz_power=MZ_POWER):
    if q_mz.size == 0 or c_mz.size == 0:
        return 0.0, 0
    qw = (q_i ** intensity_power) * (q_mz ** mz_power)
    cw = (c_i ** intensity_power) * (c_mz ** mz_power)
    diff = np.abs(q_mz[:, None] - c_mz[None, :])
    ia_idx, ib_idx = np.nonzero(diff <= tol_da)
    if ia_idx.size == 0:
        return 0.0, 0
    pair_w = qw[ia_idx] * cw[ib_idx]
    order = np.argsort(-pair_w)
    used_a = np.zeros(q_mz.size, dtype=bool)
    used_b = np.zeros(c_mz.size, dtype=bool)
    score = 0.0
    matched = 0
    for k in order:
        ia, ib = ia_idx[k], ib_idx[k]
        if used_a[ia] or used_b[ib]:
            continue
        used_a[ia] = True
        used_b[ib] = True
        score += pair_w[k]
        matched += 1
    norm = np.sqrt((qw ** 2).sum() * (cw ** 2).sum())
    return (float(score / norm) if norm > 0 else 0.0), matched
 
 
def _sum_normalize(inten):
    total = inten.sum()
    return inten / total if total > 0 else inten
 
 
def _shannon_entropy(p):
    p = p[p > 0]
    return float(-np.sum(p * np.log(p))) if p.size else 0.0
 
 
def _merge_spectra(mz1, i1, mz2, i2, tol_da):
    n1, n2 = len(mz1), len(mz2)
    merged = []
    a = b = 0
    while a < n1 and b < n2:
        if abs(mz1[a] - mz2[b]) <= tol_da:
            merged.append(i1[a] + i2[b]); a += 1; b += 1
        elif mz1[a] < mz2[b]:
            merged.append(i1[a]); a += 1
        else:
            merged.append(i2[b]); b += 1
    while a < n1:
        merged.append(i1[a]); a += 1
    while b < n2:
        merged.append(i2[b]); b += 1
    return np.asarray(merged, dtype=float)
 
 
def entropy_similarity(q_mz, q_i, c_mz, c_i, tol_da):
    if q_mz.size == 0 or c_mz.size == 0:
        return 0.0
    qo, co = np.argsort(q_mz), np.argsort(c_mz)
    qm, qi = q_mz[qo], _sum_normalize(q_i[qo])
    cm, ci = c_mz[co], _sum_normalize(c_i[co])
    merged = _sum_normalize(_merge_spectra(qm, qi, cm, ci, tol_da))
    s_ab, s_a, s_b = _shannon_entropy(merged), _shannon_entropy(qi), _shannon_entropy(ci)
    sim = 1.0 - (2 * s_ab - s_a - s_b) / np.log(4.0)
    return float(np.clip(sim, 0.0, 1.0))
 
 
def spectral_similarity(q_mz, q_i, q_pmz, c_mz, c_i, c_pmz, tol_da=FRAGMENT_TOL_DA):
    shift = q_pmz - c_pmz
    cos_d, matched_d = weighted_cosine(q_mz, q_i, c_mz, c_i, tol_da)
    if abs(shift) > tol_da:
        cos_s, matched_s = weighted_cosine(q_mz, q_i, c_mz + shift, c_i, tol_da)
    else:
        cos_s, matched_s = 0.0, 0
    cos_score, matched = (cos_s, matched_s) if cos_s > cos_d else (cos_d, matched_d)
 
    ent_d = entropy_similarity(q_mz, q_i, c_mz, c_i, tol_da)
    ent_s = entropy_similarity(q_mz, q_i, c_mz + shift, c_i, tol_da) if abs(shift) > tol_da else 0.0
    ent_score = max(ent_d, ent_s)
 
    combined = COSINE_WEIGHT * cos_score + ENTROPY_WEIGHT * ent_score
    return combined, matched
 
 
# ============================================================
# 4. LOAD
# ============================================================
 
TRAIN_COLS = ["normalized_smiles", "inchikey14", "precursor_mz", "adduct",
              "ms2_mzs", "ms2_normalized_intensities"]
TEST_COLS = ["molecule_id", "spectrum_id", "precursor_mz", "adduct",
             "ms2_mzs", "ms2_normalized_intensities"]
 
 
def load_train(path: str) -> pd.DataFrame:
    df = pd.read_parquet(path, columns=TRAIN_COLS)
    cleaned = df.apply(
        lambda r: preprocess_spectrum(r["ms2_mzs"], r["ms2_normalized_intensities"]), axis=1
    )
    df["ms2_mzs"] = cleaned.apply(lambda t: t[0])
    df["ms2_normalized_intensities"] = cleaned.apply(lambda t: t[1])
    df["neutral_mass"] = compute_neutral_masses(df)
    order = np.argsort(df["precursor_mz"].to_numpy())
    df = df.iloc[order].reset_index(drop=True)
    return df
 
 
def load_test(path: str) -> pd.DataFrame:
    df = pd.read_parquet(path, columns=TEST_COLS)
    return df
 
 
# ============================================================
# 5. RETRIEVAL.
# ============================================================
 
 
def build_library_index(df: pd.DataFrame) -> dict:
    pmz = df["precursor_mz"].to_numpy()
    nmass = df["neutral_mass"].to_numpy()
    pmz_order = np.argsort(pmz)
    nmass_order = np.argsort(nmass)
    return {
        "df": df,
        "pmz_sorted": pmz[pmz_order],
        "pmz_order": pmz_order,
        "nmass_sorted": nmass[nmass_order],
        "nmass_order": nmass_order,
        "pmz_all": pmz,
    }
 
 
def _window(sorted_vals, order, center, tol):
    lo = np.searchsorted(sorted_vals, center - tol, side="left")
    hi = np.searchsorted(sorted_vals, center + tol, side="right")
    return order[lo:hi]
 
 
def get_candidates(q_mz, q_i, q_pmz, q_adduct, lib_index: dict) -> dict:
    tol_pmz = max(q_pmz * PRECURSOR_TOL_PPM / 1e6, PRECURSOR_TOL_DA_FLOOR)
    idx_pmz = _window(lib_index["pmz_sorted"], lib_index["pmz_order"], q_pmz, tol_pmz)
 
    q_neutral = neutral_mass_of_query(q_pmz, q_adduct)
    tol_nmass = max(q_neutral * PRECURSOR_TOL_PPM / 1e6, PRECURSOR_TOL_DA_FLOOR)
    idx_nmass = _window(lib_index["nmass_sorted"], lib_index["nmass_order"], q_neutral, tol_nmass)
 
    idx = np.union1d(idx_pmz, idx_nmass)
 
    if idx.size == 0:  # nothing within tight windows -- widen once on raw m/z
        idx = _window(lib_index["pmz_sorted"], lib_index["pmz_order"], q_pmz, WIDE_FALLBACK_DA)
    if idx.size == 0:
        return {}
 
    if idx.size > MAX_CANDIDATES_PER_QUERY:
        dists = np.abs(lib_index["pmz_all"][idx] - q_pmz)
        keep = np.argsort(dists)[:MAX_CANDIDATES_PER_QUERY]
        idx = idx[keep]
 
    df = lib_index["df"]
    sub = df.iloc[idx]
    smiles_arr = sub["normalized_smiles"].to_numpy()
    key_arr = sub["inchikey14"].to_numpy()
    pmz_arr = sub["precursor_mz"].to_numpy()
    mz_col = sub["ms2_mzs"].to_numpy()
    inten_col = sub["ms2_normalized_intensities"].to_numpy()
 
    best = {}
    for j in range(len(idx)):
        c_mz = np.asarray(mz_col[j], dtype=float)
        c_i = np.asarray(inten_col[j], dtype=float)
        if c_i.size == 0:
            continue
        score, matched = spectral_similarity(q_mz, q_i, q_pmz, c_mz, c_i, pmz_arr[j])
        key = key_arr[j]
        if key not in best or score > best[key][0]:
            best[key] = (score, smiles_arr[j], matched)
 
    return best
 
 
# ============================================================
# 6. MOLECULE-LEVEL RANKING
# ============================================================
 
 
def rank_molecule(spectra_rows: list, lib_index: dict, top_k: int = TOP_K) -> list:
    combined = {}  ---key -> [best_score, best_matched, support_count]
    for row in spectra_rows:
        q_mz, q_i = preprocess_spectrum(row["ms2_mzs"], row["ms2_normalized_intensities"])
        if q_mz.size == 0:
            continue
        cands = get_candidates(q_mz, q_i, row["precursor_mz"], row.get("adduct"), lib_index)
        for key, (score, smi, matched) in cands.items():
            if key not in combined:
                combined[key] = [score, smi, matched, 1]
            else:
                entry = combined[key]
                if score > entry[0]:
                    entry[0], entry[1], entry[2] = score, smi, matched
                entry[3] += 1
 
    ranked = sorted(combined.items(), key=lambda kv: (-kv[1][0], -kv[1][2], -kv[1][3]))
    return [v[1] for _key, v in ranked[:top_k]]
 
 
# ============================================================
# 7. VALIDATION -- MRR@25
# ============================================================
 
 
def run_validation(train_df: pd.DataFrame, holdout_molecules: int = 150, seed: int = 0):
    rng = np.random.default_rng(seed)
    unique_keys = train_df["inchikey14"].unique()
    if len(unique_keys) <= holdout_molecules * 2:
        holdout_molecules = max(1, len(unique_keys) // 5)
    hold_keys = set(rng.choice(unique_keys, size=holdout_molecules, replace=False))
 
    is_holdout = train_df["inchikey14"].isin(hold_keys).to_numpy()
    holdout_df = train_df[is_holdout].reset_index(drop=True)
    library_df = train_df[~is_holdout].reset_index(drop=True)
    lib_index = build_library_index(library_df)
 
    smi_to_key = dict(zip(train_df["normalized_smiles"], train_df["inchikey14"]))
 
    rrs = []
    for truth_key, group in holdout_df.groupby("inchikey14"):
        rows = group.to_dict("records")
        preds = rank_molecule(rows, lib_index)
        rr = 0.0
        for rank, smi in enumerate(preds, start=1):
            if smi_to_key.get(smi) == truth_key:
                rr = 1.0 / rank
                break
        rrs.append(rr)
 
    score = float(np.mean(rrs)) if rrs else 0.0
    print(f"Local validation MRR@25 ({len(rrs)} held-out molecules): {score:.4f}")
    return score
 
 
# ============================================================
# 8. PIPELINE
# ============================================================
 
 
def make_submission(train_path: str, test_path: str, out_path: str,
                     sample_sub_path: str = None):
    print("Loading train (library)...")
    train_df = load_train(train_path)
    print(f"Loaded {len(train_df):,} library spectra "
          f"({train_df['inchikey14'].nunique():,} unique structures)")
 
    print("Loading test...")
    test_df = load_test(test_path)
    print(f"Loaded {len(test_df):,} test spectra across "
          f"{test_df['molecule_id'].nunique():,} molecules")
 
    print("\nRunning local validation on held-out train molecules...")
    run_validation(train_df)
 
    print("\nBuilding full library index...")
    lib_index = build_library_index(train_df)
 
    print("Ranking test molecules...")
    rows = []
    for molecule_id, group in test_df.groupby("molecule_id"):
        spectra_rows = group.to_dict("records")
        preds = rank_molecule(spectra_rows, lib_index)
        rows.append({"molecule_id": molecule_id, "smiles": ";".join(preds)})
 
    sub = pd.DataFrame(rows, columns=["molecule_id", "smiles"])
 
    assert sub["molecule_id"].is_unique, "duplicate molecule_id in submission"
    assert sub["molecule_id"].notna().all(), "null molecule_id"
    assert sub["smiles"].notna().all(), "null smiles field"
    assert (sub["smiles"].str.split(";").apply(len) <= 25).all(), "over 25 guesses somewhere"
 
    if sample_sub_path and os.path.exists(sample_sub_path):
        sample = pd.read_csv(sample_sub_path)
        id_col = "molecule_id" if "molecule_id" in sample.columns else sample.columns[0]
        expected_ids = set(sample[id_col])
        got_ids = set(sub["molecule_id"])
        missing, extra = expected_ids - got_ids, got_ids - expected_ids
        if missing:
            print(f"WARNING: {len(missing)} molecule_ids missing, e.g. {list(missing)[:5]}")
        if extra:
            print(f"WARNING: {len(extra)} unexpected molecule_ids, e.g. {list(extra)[:5]}")
        if not missing and not extra:
            print("molecule_id set matches sample_submission.csv exactly. Good.")
        sub = sub.set_index("molecule_id").loc[sample[id_col]].reset_index()
 
    empty_preds = (sub["smiles"] == "").sum()
    if empty_preds:
        print(f"NOTE: {empty_preds} molecules got zero candidates within the "
              f"precursor/neutral-mass windows -- consider widening WIDE_FALLBACK_DA.")
 
    sub.to_csv(out_path, index=False)
    print(f"\nWrote {out_path}  ({len(sub)} rows)")
    return sub
 
 
